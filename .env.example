# Шаблон настроек. Рабочий файл — .env (он в .gitignore и не попадает в git).
# Достаточно одного ключа LLM. Остальные, если заполнить, станут запасными (фолбэки).
# Порядок и модели провайдеров — в services/rag/src/genshin_rag/config.py (список PROVIDERS).

# ===== LLM =====
# Основной: console.groq.com/keys
GROQ_API_KEY=
# Запасные (необязательно):
# console.mistral.ai → API Keys
MISTRAL_API_KEY=
# aistudio.google.com/apikey
GEMINI_API_KEY=
# openrouter.ai/keys
OPENROUTER_API_KEY=

# ===== RAG-сервис =====
# Qdrant: пусто = локальная папка data/qdrant. Для сервера из docker compose: http://localhost:6333
QDRANT_URL=
# Эмбеддинги: local — модель на компьютере (по умолчанию), api — через OpenAI-совместимый /embeddings.
# У Groq эмбеддингов нет, поэтому для api нужен другой провайдер (например, Mistral).
# Сменила модель или провайдера эмбеддингов — запусти `uv run genshin index --rebuild`.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Для EMBEDDING_PROVIDER=api:
# EMBEDDING_MODEL=mistral-embed
# EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# EMBEDDING_API_KEY_ENV=MISTRAL_API_KEY

# ===== Telegram-бот =====
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Адрес RAG-сервиса, к которому ходит бот
RAG_API_URL=http://127.0.0.1:8000
# Необязательно: прокси, если Telegram у тебя работает только через VPN/прокси.
# Например socks5://127.0.0.1:1080 или http://127.0.0.1:8080 (порт смотри в настройках VPN-приложения)
TELEGRAM_PROXY=
